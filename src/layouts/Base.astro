---
import "../styles/global.css";
import DotField from "../components/DotField.astro";
import Icon from "../components/Icon.astro";
import { locales, htmlLang, type Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Dil öneki olmadan sayfa yolu: "" (ana sayfa), "destek", … */
  path?: string;
  /** Arama sonuçlarında istenmeyen sayfalar (ör. yönetim paneli). */
  noindex?: boolean;
  /** Sayfaya özel ek yapısal veri (ana sayfada uygulama, SSS, kurulum). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, title, description, path = "", noindex = false, schema } = Astro.props;

const site = Astro.site ?? new URL("https://mac-utils.web.app");
const suffix = path ? `/${path}` : "";
const canonical = new URL(`/${lang}${suffix}`, site);

/**
 * Üç dil birbirinin çevirisi olduğu için her sayfa diğer ikisini
 * `hreflang` ile işaret ediyor. Bu olmadan arama motorları üç sayfayı
 * ayrı ayrı sıralamaya sokup birbirinin kopyası sanabiliyor — çok dilli
 * bir sitede en sık yapılan hata bu.
 */
const alternates = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(`/${l}${suffix}`, site).href,
}));

const ogImage = new URL("/og.png", site).href;

/**
 * Site geneli yapısal veri.
 *
 * Burada yalnızca her sayfa için doğru olan şeyler var: sitenin kendisi
 * ve arkasındaki kişi. Uygulamanın künyesi (`SoftwareApplication`),
 * SSS ve kurulum adımları yalnızca ana sayfada — eskiden uygulama
 * künyesi buradaydı ve gizlilik politikası sayfası da kendini bir
 * uygulama olarak tanıtıyordu.
 */
const structuredData: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site.origin}/#website`,
    name: "GlassDo",
    url: site.origin,
    description,
    inLanguage: htmlLang[lang],
    publisher: { "@id": `${site.origin}/#author` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${site.origin}/#author`,
    name: "Dadebay",
    url: "https://github.com/Dadebay",
    sameAs: ["https://github.com/Dadebay", "https://github.com/Dadebay/my_mac_utils"],
  },
];

/**
 * Alt sayfalarda kırıntı yolu: arama sonucunda adresin yerine
 * "GlassDo › Destek" gibi bir yol görünüyor.
 */
if (path) {
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "GlassDo", item: new URL(`/${lang}`, site).href },
      { "@type": "ListItem", position: 2, name: title, item: canonical.href },
    ],
  });
}
---

<!doctype html>
<html lang={htmlLang[lang]} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {/*
      Zengin sonuç izinleri: büyük görsel önizleme ve kısaltılmamış
      alıntı. Varsayılan davranış kısa alıntı ve küçük görsel; bu satır
      olmadan hem arama sonucunda hem de sayfayı okuyan yapay zekâ
      araçlarında içeriğin yalnızca bir kırıntısı görünüyor.
    */}
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {/* Dili eşleşmeyen ziyaretçi İngilizce sürüme gitsin. */}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${suffix}`, site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GlassDo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:image" content={ogImage} />
    {/* Ölçüler paylaşım kartını daha ilk istekte doğru boyutta çizdiriyor;
        `alt` ise kartı ekran okuyucuya açıklıyor. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GlassDo — macOS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="GlassDo — macOS" />

    {/* Tarayıcı çubuğunun rengi temayla birlikte değişiyor; değeri
        tema betiği yazıyor (bkz. aşağıdaki satır içi betik). */}
    <meta name="theme-color" content="#0a0b0f" data-theme-color />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    {/* Başlıkta kullanılan iki ağırlık önden yükleniyor: yazı tipi geç
        gelirse metin önce sistem fontuyla çizilip sonra kayıyor. */}
    <link rel="preload" href="/fonts/gilroy/Gilroy-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/gilroy/Gilroy-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    {/* Marka yazısı sayfanın ilk göründüğü yerde: geç gelirse logo önce
        gövde yazı tipiyle çizilip sonra değişiyor. */}
    <link rel="preload" href="/fonts/qurova/QurovaDEMO-Medium.otf" as="font" type="font/otf" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* Beliren bölümler yalnızca betik çalışırsa gizleniyor; bu satır
        `<head>` içinde, ilk boyamadan önce çalışıyor ki içerik önce
        görünüp sonra kaybolmasın. */}
    <script is:inline>
      document.documentElement.classList.add("js");

      /*
       * Tema ilk boyamadan ÖNCE yazılıyor. Sayfa açılınca bir kare koyu
       * görünüp sonra beyaza dönmesi ("flash") başka türlü kaçınılmaz:
       * stil dosyası temayı `<html data-theme>` üzerinden okuyor.
       *
       * Sıra: kullanıcının kendi seçimi → işletim sistemi tercihi →
       * koyu. Gizli sekmede localStorage erişimi hata atabildiği için
       * tamamı try içinde.
       */
      (() => {
        let theme = "dark";
        try {
          const stored = localStorage.getItem("glassdo-theme");
          theme =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
        } catch {}
        document.documentElement.dataset.theme = theme;
        const meta = document.querySelector("[data-theme-color]");
        if (meta) meta.setAttribute("content", theme === "light" ? "#ffffff" : "#0a0b0f");
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col bg-background font-sans text-foreground antialiased">
    <DotField />

    <slot />

    {/* Ekran görüntülerine tıklanınca açılan büyüteç. Tetikleyiciler
        `Mockup.astro` içinde; burada tek bir paylaşılan pencere var. */}
    <div
      data-lightbox
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm sm:p-10"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
    >
      <button
        type="button"
        data-lightbox-close
        class="absolute right-4 top-4 rounded-full border border-white/15 bg-white/5 p-2 text-white/80 transition-colors hover:text-white sm:right-6 sm:top-6"
        aria-label="Kapat"
      >
        <Icon name="x" class="h-5 w-5" />
      </button>
      <img data-lightbox-image src="" alt="" class="max-h-full max-w-full rounded-2xl object-contain shadow-2xl" />
    </div>

    {/* Harfleri kum tanelerine ayıran parçacık sistemi. */}
    <script>
      import "../scripts/sand";
    </script>

    {/*
      Kum taneciği maskesini nav bar'ın altına sabitle.

      Maske, maskelenen öğenin kendi kutusuna göre konumlanıyor; öğe
      sayfayla birlikte kaydığı için bandın viewport'ta sabit durması adına
      her karede öğenin üst kenarına olan uzaklığı yazıyoruz. Kare başına
      iki özellik yazımı — scroll dinleyicisi `passive` ve iş rAF'a
      toplanıyor, yani kaydırma bloke edilmiyor.
    */}
    <script is:inline>
      (() => {
        const roots = document.querySelectorAll("[data-dissolve-root]");
        if (!roots.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        /* Nav bar'ın alt hizası: üst boşluk + yüksekliği. */
        const navBottom = 88;
        let queued = false;

        const update = () => {
          queued = false;
          for (const root of roots) {
            const band = parseFloat(getComputedStyle(root).getPropertyValue("--dissolve-band")) || 0;
            const offset = navBottom - root.getBoundingClientRect().top;
            /*
             * Alt sınır -bant: öğe tamamen nav'ın altındayken bant öğenin
             * üstüne, görünmez bir yere çekiliyor. Daha yukarı taşınırsa
             * bandın altındaki opak katman öğenin alt ucuna yetişemiyor ve
             * sayfanın dibi kesiliyor.
             */
            root.style.setProperty("--dissolve-y", Math.max(-band, offset) + "px");
          }
        };

        const schedule = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        };

        update();
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule);
      })();
    </script>

    {/*
      Beliren bölümleri görünür alana girdikçe aç.

      İki şey önemli: bölümler ekrana girmeden epey önce (600px) açılmaya
      başlıyor ve hızlı kaydırmada beliriş tamamen atlanıyor. Öncesinde
      hızlı kaydırınca ekranlar dolusu içerik yarım saniye boyunca
      saydam kalıyor, yani "yetişemiyordu".
    */}
    <script is:inline>
      (() => {
        const items = document.querySelectorAll("[data-reveal]");
        if (!items.length) return;

        const reveal = (element) => element.classList.add("is-visible");

        if (!("IntersectionObserver" in window)) {
          items.forEach(reveal);
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              reveal(entry.target);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "600px 0px 600px 0px" },
        );

        items.forEach((item) => observer.observe(item));

        /* Kaydırma bir karede 300 pikselden fazla atladıysa beliriş
           kuyruğa girmesin: kalan her şey anında açılıyor. */
        let previous = window.scrollY;
        addEventListener(
          "scroll",
          () => {
            const jump = Math.abs(window.scrollY - previous);
            previous = window.scrollY;
            if (jump < 300) return;
            document.documentElement.classList.add("reveal-instant");
            items.forEach(reveal);
            observer.disconnect();
          },
          { passive: true },
        );
      })();
    </script>

    {/* Ekran görüntüsü büyüteci: tetikleyici herhangi bir yerde
        `data-lightbox-trigger` taşıyabilir (bkz. `Mockup.astro`),
        pencere burada tek bir kopya. */}
    <script is:inline>
      (() => {
        const lightbox = document.querySelector("[data-lightbox]");
        const image = document.querySelector("[data-lightbox-image]");
        const closeButton = document.querySelector("[data-lightbox-close]");
        const triggers = document.querySelectorAll("[data-lightbox-trigger]");
        if (!lightbox || !image || !closeButton || !triggers.length) return;

        let lastFocused = null;

        const open = (src, alt) => {
          lastFocused = document.activeElement;
          image.setAttribute("src", src);
          image.setAttribute("alt", alt);
          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
          lightbox.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
          closeButton.focus();
        };

        const close = () => {
          lightbox.classList.add("hidden");
          lightbox.classList.remove("flex");
          lightbox.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
          image.setAttribute("src", "");
          if (lastFocused instanceof HTMLElement) lastFocused.focus();
        };

        triggers.forEach((trigger) => {
          trigger.addEventListener("click", () => {
            const src = trigger.getAttribute("data-lightbox-src");
            const alt = trigger.getAttribute("data-lightbox-alt") ?? "";
            if (src) open(src, alt);
          });
        });

        closeButton.addEventListener("click", close);
        lightbox.addEventListener("click", (event) => {
          if (event.target === lightbox) close();
        });
        addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !lightbox.classList.contains("hidden")) close();
        });
      })();
    </script>

  </body>
</html>
